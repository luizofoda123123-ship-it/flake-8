#primeiro comando


TAX_RATE = 0.2

def calculate_tax(price):
    return price * TAX_RATE
    
def sum_prices(*prices):
    return sum(prices)


total = sum_prices(100, 200, 300, 400)
tax = calculate_tax(total)
final_price = total + tax
print ("Final price is", final_price) 







